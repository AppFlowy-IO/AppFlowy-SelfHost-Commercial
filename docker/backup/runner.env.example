# Private operator file: copy to backup-ops/runner.env with mode 0600.
# The backup override shares artifact settings with Cloud for downloads and multipart uploads.
# Source database, Redis and application S3 settings are inherited from the root deployment;
# do not duplicate or replace their credentials here. Availability uses the runner heartbeat.
APPFLOWY_BACKUP_WORK_DIR=/var/lib/appflowy-backup/work
APPFLOWY_BACKUP_MIN_FREE_BYTES=1073741824
APPFLOWY_BACKUP_OBJECT_CONCURRENCY=8
APPFLOWY_BACKUP_PAYLOAD_MEMORY_MIB=512
APPFLOWY_BACKUP_TRANSFER_CONCURRENCY=8
APPFLOWY_BACKUP_CODEC_CONCURRENCY=2
APPFLOWY_BACKUP_MULTIPART_CONCURRENCY=4
# File-backed transfer ranges are read through bounded buffers.
APPFLOWY_BACKUP_MULTIPART_PART_MIB=64
# Optional estimated staging cap; zero disables this additional cap.
APPFLOWY_BACKUP_STAGING_QUOTA_BYTES=0
APPFLOWY_BACKUP_JOB_TIMEOUT_SECONDS=86400
APPFLOWY_BACKUP_POSTGRES_TIMEOUT_SECONDS=43200
APPFLOWY_BACKUP_RECOVERY_TIMEOUT_SECONDS=3600
APPFLOWY_BACKUP_MAINTENANCE_TIMEOUT_SECONDS=300
APPFLOWY_BACKUP_INVENTORY_REFRESH_SECONDS=3600
APPFLOWY_BACKUP_INVENTORY_REFRESH_BUDGET_SECONDS=60
# Keep the work volume persistent so its generated runner identity survives recreation.
# APPFLOWY_BACKUP_RUNNER_ID=backup-runner-1
APPFLOWY_BACKUP_UPLOAD_RESUME_SECONDS=86400
APPFLOWY_BACKUP_PG_SHARED_BUFFERS_MIB=128
APPFLOWY_BACKUP_RETENTION_HOURS=24
APPFLOWY_BACKUP_RECOVERY_RETENTION_HOURS=720

# Private artifacts are separate from public application attachments.
# The explicit credential pair is shared by Cloud and Backup through this file.
APPFLOWY_BACKUP_S3_USE_MINIO=false
APPFLOWY_BACKUP_BUCKET=appflowy-recovery-artifacts
APPFLOWY_BACKUP_PREFIX=server-backups/
APPFLOWY_BACKUP_S3_REGION=us-east-1
APPFLOWY_BACKUP_S3_ACCESS_KEY=replace-me
APPFLOWY_BACKUP_S3_SECRET_KEY=replace-me
# APPFLOWY_BACKUP_S3_ENDPOINT=https://backup-objects.example.com
# APPFLOWY_BACKUP_S3_CA_BUNDLE=/etc/appflowy-backup/backup-ca.pem
# APPFLOWY_BACKUP_S3_ADDRESSING_STYLE=path

APPFLOWY_BACKUP_PGBACKREST_CONFIG=/etc/pgbackrest/pgbackrest.conf
APPFLOWY_BACKUP_PGBACKREST_CONFIG_INCLUDE_PATH=/etc/pgbackrest/conf.d
APPFLOWY_BACKUP_PGBACKREST_STANZA=appflowy
APPFLOWY_BACKUP_PGBACKREST_REPO=1
APPFLOWY_BACKUP_MAINTENANCE_COMMAND=["appflowy_backup","maintenance"]
APPFLOWY_BACKUP_COORDINATOR_SOCKET=/var/run/appflowy-backup/coordinator.sock
